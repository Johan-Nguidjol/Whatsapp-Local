<Window x:Class="ChatLocal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatLocal"
        Title="{Binding WindowTitle}" Icon="/Assets/WhatsApp.ico" Height="640" Width="960" MinHeight="360" MinWidth="580"
        Background="{StaticResource ChatBg}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Avatar rond avec initiale (Contact ou StatusGroup) -->
        <DataTemplate x:Key="AvatarTemplate">
            <Grid>
                <Ellipse Fill="{Binding AvatarBg}"/>
                <Viewbox Margin="12">
                    <TextBlock Text="{Binding Initial}" Foreground="{Binding AvatarFg}"
                               FontWeight="SemiBold" FontSize="20"/>
                </Viewbox>
                <Border CornerRadius="1000" ClipToBounds="True" Background="Transparent">
                    <Image Source="{Binding ProfilePhoto}" Stretch="UniformToFill"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Texte indicatif (placeholder) : visible seulement si Tag est vide -->
        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Bouton emoji dans la palette -->
        <Style x:Key="EmojiGridButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseViewerCommand}"/>
        <KeyBinding Key="Left" Command="{Binding PrevCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="2.5*" MinWidth="205"/>
            <ColumnDefinition Width="4.8*" MinWidth="290"/>
        </Grid.ColumnDefinitions>

        <!-- ================= COLONNE D'ICÔNES ================= -->
        <Border Grid.Column="0" Background="{StaticResource RailBg}">
            <DockPanel LastChildFill="False" Margin="0,12">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,6">
                        <Button Command="{Binding ShowChatsCommand}" Content="&#xE8BD;" ToolTip="{DynamicResource UI.Chats}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChatsTab}" Value="True">
                                            <Setter Property="Background" Value="#2A2A2A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Background="{DynamicResource Accent}" CornerRadius="9" MinWidth="18" Height="18"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,2,0" IsHitTestVisible="False"
                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TotalUnread}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                        </Border>
                    </Grid>

                    <Grid Width="40" Height="40">
                        <Button Command="{Binding ShowStatusCommand}" ToolTip="{DynamicResource UI.Status}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusTab}" Value="True">
                                            <Setter Property="Background" Value="#2A2A2A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="22" Height="22">
                                <local:StatusRing Total="3" Seen="3" RingThickness="2.4" SeenBrush="#D7D9E8"/>
                                <Ellipse Width="10" Height="10" Fill="#D7D9E8"/>
                            </Grid>
                        </Button>
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource Accent}" Stroke="#1F1F1F" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" IsHitTestVisible="False"
                                 Visibility="{Binding HasUnseenStatuses, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Button Command="{Binding ShowArchivesCommand}" Content="&#xE7B8;" ToolTip="{DynamicResource UI.Archives}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Foreground" Value="#D7D9E8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchivesTab}" Value="True">
                                        <Setter Property="Background" Value="#2A2A2A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ShowCommunitiesCommand}" Content="&#xE902;" ToolTip="{DynamicResource UI.Communities}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Foreground" Value="#D7D9E8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommunitiesTab}" Value="True">
                                        <Setter Property="Background" Value="#2A2A2A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ShowMetaAiCommand}" ToolTip="Meta AI">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Foreground" Value="#D7D9E8"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsMetaAiTab}" Value="True"><Setter Property="Background" Value="#2A2A2A"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Image Source="/Assets/MetaAi.png" Width="29" Height="29" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Command="{Binding ShowSettingsCommand}" Width="38" Height="38" Padding="0" Margin="0,0,0,2"
                        Background="Transparent" BorderThickness="0" ToolTip="{Binding MyName}">
                    <Grid Width="30" Height="30">
                    <Ellipse Fill="{StaticResource SurfaceBg}" Stroke="#667781" StrokeThickness="1"/>
                    <TextBlock Text="{Binding MyInitial}" Foreground="White" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding ProfilePhoto}" Width="28" Height="28" Stretch="UniformToFill">
                        <Image.Clip><EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14"/></Image.Clip>
                    </Image>
                    </Grid>
                </Button>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
                    <Button Command="{Binding ShowSettingsCommand}" Content="&#xE713;" ToolTip="{DynamicResource UI.Settings}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Foreground" Value="#D7D9E8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsTab}" Value="True">
                                        <Setter Property="Background" Value="#2A2A2A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= LISTE DES DISCUSSIONS ================= -->
        <Grid Grid.Column="1" Background="{StaticResource SidebarBg}"
              Visibility="{Binding IsChatsTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,16,12,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/WhatsApp.png" Width="34" Height="34" Stretch="Uniform" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Discussions" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding OnlineText}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Plus d’options" Command="{Binding OpenMoreMenuCommand}" Margin="0,0,8,0"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource RoundButton}" Width="48" Height="48"
                        Command="{Binding OpenCommunityComposerCommand}" ToolTip="Créer un groupe">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="22"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="12,4,12,10" Height="38" CornerRadius="19" Background="{DynamicResource Selected}">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource TextSecondary}" Margin="16,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="44,0,12,0"
                             BorderThickness="0" Background="Transparent" FontSize="14"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="{DynamicResource UI.Search}" FontSize="14" Margin="48,0,0,0"
                               Tag="{Binding SearchText}" Style="{StaticResource PlaceholderText}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,0,16,8">
                <RadioButton GroupName="filters" Content="{DynamicResource UI.All}" Style="{StaticResource Chip}"
                             IsChecked="{Binding FilterAll}"/>
                <RadioButton GroupName="filters" Content="{DynamicResource UI.Unread}" Style="{StaticResource Chip}"
                             IsChecked="{Binding FilterUnread}"/>
            </StackPanel>

            <ListBox Grid.Row="3" ItemsSource="{Binding ContactsView}"
                     SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                     IsSynchronizedWithCurrentItem="False"
                     ItemContainerStyle="{StaticResource ChatItem}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="72" Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="49" Height="49" VerticalAlignment="Center">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AvatarTemplate}"/>
                                <Ellipse Width="14" Height="14" Fill="{DynamicResource Accent}" Stroke="White"
                                         StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,8,0">
                                <TextBlock Text="{Binding Name}" FontSize="16" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding LastText}" FontSize="14" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding LastTimeText}" FontSize="12" HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border MinWidth="20" Height="20" CornerRadius="10" Margin="0,6,0,0"
                                        Background="{DynamicResource Accent}" HorizontalAlignment="Right"
                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Unread}" Foreground="White" FontSize="12"
                                               FontWeight="SemiBold" Margin="6,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="3" VerticalAlignment="Top" Margin="30,40" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{StaticResource TextSecondary}" FontSize="14"
                       Text="{DynamicResource UI.NoContacts}"
                       Visibility="{Binding NoContacts, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ================= DISCUSSIONS ARCHIVÉES ================= -->
        <Grid Grid.Column="1" Background="{StaticResource SidebarBg}" Visibility="{Binding IsArchivesTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="20,18,16,10">
                <TextBlock Text="{DynamicResource UI.ArchiveTitle}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="{DynamicResource UI.ArchiveSubtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Margin="12,0,12,10" Height="38" CornerRadius="19" Background="{DynamicResource Selected}">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="14,0,12,0" BorderThickness="0"
                         Background="Transparent" FontSize="14" VerticalContentAlignment="Center"/>
            </Border>
            <ListBox Grid.Row="2" ItemsSource="{Binding ContactsView}" SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ChatItem}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="70" Margin="12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AvatarTemplate}"/>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="15" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding LastText}" FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="8" ToolTip="{DynamicResource UI.ArchivedTooltip}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" Text="{DynamicResource UI.NoArchives}" Margin="22,32" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondary}" Visibility="{Binding NoArchivedContacts, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ================= COMMUNAUTÉS ================= -->
        <Grid Grid.Column="1" Background="{StaticResource SidebarBg}" Visibility="{Binding IsCommunitiesTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="18,14,12,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource UI.CommunityTitle}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource UI.CommunitySubtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Command="{Binding OpenCommunityComposerCommand}" ToolTip="{DynamicResource UI.CreateCommunity}">
                    <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconAddCircle}" Foreground="{DynamicResource Accent}"/>
                </Button>
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Communities}" BorderThickness="0" Background="Transparent" Margin="8,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="6">
                            <ContentPresenter/>
                        </Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Background="Transparent" BorderThickness="0" Padding="4" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.SelectCommunityCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <Grid Height="64">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="14" Background="{Binding AvatarBg}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initial}" Foreground="{Binding AvatarFg}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding MemberCountText}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <Border Grid.Column="2" MinWidth="20" Height="20" CornerRadius="10" Background="{DynamicResource Accent}" Padding="5,0"
                                        VerticalAlignment="Center" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="18,38" Visibility="{Binding NoCommunities, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{DynamicResource UI.NoCommunities}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextAlignment="Center"/>
                <TextBlock Text="{DynamicResource UI.NoCommunitiesHelp}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" Margin="0,6"/>
            </StackPanel>
        </Grid>

        <!-- ================= PARAMÈTRES ================= -->
        <Grid Grid.Column="1" Background="{StaticResource SidebarBg}" Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding MyName}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="24,24,20,4"/>
                <Border Grid.Row="1" Margin="18,12,18,10" Height="38" CornerRadius="19" Background="{DynamicResource Selected}">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextSecondary}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" Margin="42,0,12,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Rechercher" Style="{StaticResource PlaceholderText}" Tag="{Binding SettingsSearchText}" Margin="42,0,12,0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="18,4,18,16" Height="176">
                    <Border Height="42" VerticalAlignment="Top" HorizontalAlignment="Center" Padding="18,0" CornerRadius="22" Background="{StaticResource SurfaceBg}" BorderBrush="#383838" BorderThickness="1">
                        <TextBlock Text="Humeur actuelle" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </Border>
                    <Grid Width="136" Height="136" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                        <Ellipse Fill="{StaticResource SurfaceBg}"/>
                        <TextBlock Text="{Binding MyInitial}" Foreground="{StaticResource TextPrimary}" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding ProfilePhoto}" Stretch="UniformToFill">
                            <Image.Clip><EllipseGeometry Center="68,68" RadiusX="68" RadiusY="68"/></Image.Clip>
                        </Image>
                    </Grid>
                </Grid>
                <ListBox Grid.Row="3" ItemsSource="{Binding SettingsSectionsView}" SelectedValue="{Binding SelectedSettingsSection, Mode=TwoWay}" SelectedValuePath="Key"
                         BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="8,0,8,4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="2,2"/><Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="itemBg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBg" Property="Background" Value="#303030"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBg" Property="Background" Value="#252525"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid MinHeight="52">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,3,0,3">
                                <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="4" Command="{Binding SwitchAccountCommand}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="24,13" Margin="8,0,8,12">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" Foreground="#E57373" Margin="0,0,12,0"/><TextBlock Text="Se déconnecter / changer de compte" Foreground="#E57373"/></StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Column="2" Background="{StaticResource ChatBg}" Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="32" MinHeight="520">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760" Visibility="{Binding IsSettingsProfileSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding MyName}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ProfileSummary}" FontSize="15" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,34"/>
                        <UniformGrid Columns="4" HorizontalAlignment="Center" Width="520">
                            <Button Command="{Binding ChooseProfilePhotoCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" Padding="12">
                                <StackPanel><Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource SurfaceBg}" HorizontalAlignment="Center"><TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="25" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Changer la photo" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel>
                            </Button>
                            <Button Command="{Binding SwitchAccountCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" Padding="12">
                                <StackPanel><Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource SurfaceBg}" HorizontalAlignment="Center"><TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="25" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Changer de compte" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveProfilePhotoCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" Padding="12">
                                <StackPanel><Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource SurfaceBg}" HorizontalAlignment="Center"><TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="25" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Retirer la photo" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel>
                            </Button>
                            <Button Command="{Binding ShowMetaAiCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" Padding="12">
                                <StackPanel><Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource SurfaceBg}" HorizontalAlignment="Center"><Image Source="/Assets/MetaAi.png" Width="42" Height="42" Stretch="Uniform"/></Border><TextBlock Text="Demander à Meta AI" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="620" Visibility="{Binding IsSettingsGeneralSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Général" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24"/>
                        <TextBlock Text="{DynamicResource UI.Network}" FontSize="18" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding NetworkSummary}" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,4"/>
                        <TextBlock Text="{DynamicResource UI.NetworkHelp}" FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                        <Button Content="{DynamicResource UI.SaveSettings}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PillButton}" Height="44" HorizontalAlignment="Left" Margin="0,24,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="620" Visibility="{Binding IsSettingsAccountSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Compte" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                        <TextBlock Text="Changer de profil pour tester l’application avec un autre compte." FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,22"/>
                        <Button Content="Changer de compte" Command="{Binding SwitchAccountCommand}" Style="{StaticResource PillButton}" Height="44" HorizontalAlignment="Left" Padding="18,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="620" Visibility="{Binding IsSettingsPrivacySection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Confidentialité" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                        <TextBlock Text="Les messages éphémères se règlent depuis chaque discussion avec le menu de durée situé près de la zone de saisie." FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="620" Visibility="{Binding IsSettingsChatsSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Discussions et apparence" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24"/>
                        <TextBlock Text="{DynamicResource UI.Theme}" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetThemeColorCommand}" CommandParameter="Indigo" ToolTip="Indigo" Padding="0" BorderThickness="0" Background="Transparent" Margin="0,0,12,0"><Border Width="36" Height="36" CornerRadius="18" Background="#635BDB"/></Button>
                            <Button Command="{Binding SetThemeColorCommand}" CommandParameter="Green" ToolTip="{DynamicResource UI.GreenTheme}" Padding="0" BorderThickness="0" Background="Transparent" Margin="0,0,12,0"><Border Width="36" Height="36" CornerRadius="18" Background="#25D366"/></Button>
                            <Button Command="{Binding SetThemeColorCommand}" CommandParameter="Blue" ToolTip="{DynamicResource UI.BlueTheme}" Padding="0" BorderThickness="0" Background="Transparent" Margin="0,0,12,0"><Border Width="36" Height="36" CornerRadius="18" Background="#2F80ED"/></Button>
                            <Button Command="{Binding SetThemeColorCommand}" CommandParameter="Coral" ToolTip="{DynamicResource UI.CoralTheme}" Padding="0" BorderThickness="0" Background="Transparent"><Border Width="36" Height="36" CornerRadius="18" Background="#E76F51"/></Button>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource UI.Language}" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,24,0,8"/>
                        <ComboBox Width="200" HorizontalAlignment="Left" SelectedValue="{Binding Language, Mode=TwoWay}" SelectedValuePath="Tag"><ComboBoxItem Content="Français" Tag="fr"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="620" Visibility="{Binding IsSettingsVideoAudioSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Vidéo et audio" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                        <TextBlock Text="Les appels audio et vidéo utilisent les périphériques caméra et microphone configurés dans Windows." FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="620" Visibility="{Binding IsSettingsNotificationsSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Notifications" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,18"/>
                        <CheckBox Content="{DynamicResource UI.NotificationSounds}" IsChecked="{Binding NotificationSoundsEnabled, Mode=TwoWay}" Foreground="{StaticResource TextPrimary}" FontSize="15"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="620" Visibility="{Binding IsSettingsShortcutsSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Raccourcis clavier" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,18"/>
                        <TextBlock Text="Échap : fermer la visionneuse · ← / → : parcourir les statuts" FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="620" Visibility="{Binding IsSettingsHelpSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Aide et commentaires" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24"/>
                        <TextBlock Text="{DynamicResource UI.Network}" FontSize="18" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding NetworkSummary}" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,4"/>
                        <TextBlock Text="{DynamicResource UI.NetworkHelp}" FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Assistant IA local de démonstration -->
        <Grid Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource ChatBg}" Visibility="{Binding IsMetaAiTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SidebarBg}" Padding="22,14" BorderBrush="#263238" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Image Source="/Assets/MetaAi.png" Width="38" Height="38" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Assistant IA" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="OpenRouter ou Gemini · mode hors ligne disponible" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,20">
                <ItemsControl ItemsSource="{Binding MetaAiMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Bubble" MaxWidth="680" Padding="14,10" Margin="0,0,0,12" CornerRadius="14" HorizontalAlignment="Left" Background="#202C33">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#F1F5F6" FontSize="14"/>
                                    <TextBlock Text="{Binding Time}" HorizontalAlignment="Right" Foreground="#AAB7BD" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFromUser}" Value="True">
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Bubble" Property="Background" Value="#005C4B"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{StaticResource SidebarBg}" Padding="18,10" BorderBrush="#263238" BorderThickness="0,1,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,7">
                        <TextBlock Text="Fournisseur IA" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <ComboBox DockPanel.Dock="Right" Width="190" SelectedValuePath="Tag" SelectedValue="{Binding MetaAiProvider, UpdateSourceTrigger=PropertyChanged}" Background="#202C33" Foreground="#F1F5F6" BorderThickness="0" Padding="6,4">
                            <ComboBoxItem Content="OpenRouter · modèles gratuits" Tag="OpenRouter"/>
                            <ComboBoxItem Content="Gemini" Tag="Gemini"/>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock Text="{Binding MetaAiStatusText}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Enregistrer la clé" Click="SaveGeminiApiKey_Click" Margin="8,0,0,0" Padding="12,6" Background="#263238" Foreground="{StaticResource TextPrimary}" BorderThickness="0"/>
                        <Button DockPanel.Dock="Right" Content="Retirer" Command="{Binding RemoveGeminiApiKeyCommand}" Margin="8,0,0,0" Padding="10,6" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0"/>
                        <PasswordBox x:Name="GeminiApiKeyBox" Padding="10,6" Background="#202C33" Foreground="#F1F5F6" BorderThickness="0" ToolTip="Clé API du fournisseur sélectionné (stockée chiffrée sur cet ordinateur)"/>
                    </DockPanel>
                    <TextBlock Text="Clés : openrouter.ai/keys · aistudio.google.com/apikey" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Background="{StaticResource SidebarBg}" Padding="18,12" BorderBrush="#263238" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Envoyer" Command="{Binding SendMetaAiCommand}" Margin="10,0,0,0" Padding="18,9" Background="#00A884" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding MetaAiPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" VerticalContentAlignment="Center" Padding="14,10" FontSize="14" Background="#202C33" Foreground="#F1F5F6" BorderThickness="0" ToolTip="Écris une question pour la démo"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= LISTE DES STATUTS ================= -->
        <Grid Grid.Column="1" Background="{StaticResource SidebarBg}"
              Visibility="{Binding IsStatusTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête : Statut / ⋮ / ⊕ -->
            <Grid Grid.Row="0" Margin="22,16,12,6" Height="40">
                <TextBlock Text="{DynamicResource UI.Status}" FontSize="20" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimary}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" ToolTip="{DynamicResource UI.AddStatus}"
                            Command="{Binding OpenStatusMenuCommand}">
                        <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconAddCircle}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Mon statut -->
            <Grid Grid.Row="1" Margin="10,0" Height="72">
                <Button Style="{StaticResource RowButton}" Command="{Binding OpenMyStatusCommand}">
                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="MyAvatar" Width="52" Height="52" VerticalAlignment="Center">
                            <local:StatusRing Total="{Binding MyStatusGroup.Total}" Seen="{Binding MyStatusGroup.SeenCount}"/>
                            <Ellipse Width="44" Height="44" Fill="{Binding MyStatusGroup.ThumbBrush}"/>
                            <TextBlock Text="{Binding MyInitial}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
                                       FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding MyStatusGroup.NoPosts, Converter={StaticResource BoolToVis}}"/>
                            <Image Source="{Binding ProfilePhoto}" Width="42" Height="42" Stretch="UniformToFill">
                                <Image.Clip><EllipseGeometry Center="21,21" RadiusX="21" RadiusY="21"/></Image.Clip>
                            </Image>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="{DynamicResource UI.MyStatus}" FontSize="16" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding MyStatusGroup.TimeText}" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Badge vert + -->
                <Button Style="{StaticResource PlusBadge}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="42,0,0,12" Command="{Binding OpenStatusMenuCommand}"/>

                <!-- Menu déroulant : Photos et vidéos / Texte -->
                <Popup IsOpen="{Binding IsStatusMenuOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                       Placement="Bottom" PlacementTarget="{Binding ElementName=MyAvatar}" HorizontalOffset="-6">
                    <Border Margin="10" Background="{StaticResource SurfaceBg}" CornerRadius="12" Padding="0,6" MinWidth="170"
                            BorderBrush="#12000000" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <Button Style="{StaticResource MenuRow}" Command="{Binding PickPhotoCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconPhotoLibrary}"
                                             Width="18" Height="18" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{DynamicResource UI.PhotosVideos}" FontSize="13.5" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuRow}" Command="{Binding StartComposeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconEdit}"
                                             Width="18" Height="18" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{DynamicResource UI.PlainText}" FontSize="13.5" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <TextBlock Grid.Row="2" Text="{DynamicResource UI.Recents}" FontSize="12.5" Margin="26,18,0,6"
                       Foreground="{StaticResource TextSecondary}"/>

            <!-- Statuts récents -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RecentStatuses}" Margin="10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Height="72"
                                    Command="{Binding DataContext.OpenStatusGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="52" Height="52" VerticalAlignment="Center">
                                        <local:StatusRing Total="{Binding Total}" Seen="{Binding SeenCount}"/>
                                        <Ellipse Width="44" Height="44" Fill="{Binding ThumbBrush}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding AuthorName}" FontSize="16" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding TimeText}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="3" VerticalAlignment="Top" Margin="30,30" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{StaticResource TextSecondary}" FontSize="14"
                       Text="{DynamicResource UI.NoStatus}"
                       Visibility="{Binding NoRecents, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Séparateur vertical entre la liste et la zone de droite -->
        <Border Grid.Column="1" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0"
                IsHitTestVisible="False"/>

        <!-- ================= DROITE : ACCUEIL ================= -->
        <Grid Grid.Column="2" Background="{StaticResource ChatBg}"
              Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                <Image Source="/Assets/WhatsApp.png" Width="96" Height="96" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="WhatsApp" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           Text="{DynamicResource UI.ChatDescription}"/>
            </StackPanel>
        </Grid>

        <!-- ================= DROITE : DISCUSSION ================= -->
        <Grid Grid.Column="2" Background="{StaticResource ChatPattern}"
              Visibility="{Binding ShowChat, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête de discussion avec boutons d'appels -->
            <Border Grid.Row="0" Height="60" Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Bouton Appel Vidéo -->
                        <Button Style="{StaticResource IconButton}" Command="{Binding StartVideoCallCommand}"
                                ToolTip="{DynamicResource UI.VideoCall}" Margin="0,0,6,0">
                            <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconVideo}"/>
                        </Button>
                        <!-- Bouton Appel Audio -->
                        <Button Style="{StaticResource IconButton}" Command="{Binding StartAudioCallCommand}"
                                ToolTip="{DynamicResource UI.AudioCall}" Margin="0,0,4,0">
                            <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconCall}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleArchiveCommand}"
                                ToolTip="{Binding ArchiveActionText}">
                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="17"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="40" Height="40" VerticalAlignment="Center">
                            <ContentControl Content="{Binding SelectedContact}" ContentTemplate="{StaticResource AvatarTemplate}"/>
                        </Grid>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedContact.Name}" FontSize="16"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding SelectedContact.PresenceText}" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Liste des messages -->
            <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CurrentMessages}" Margin="48,12,48,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Message Appel -->
                            <Grid Margin="0,4">
                                <Border Visibility="{Binding IsCall, Converter={StaticResource BoolToVis}}"
                                        Background="{StaticResource SurfaceBg}" CornerRadius="8" Padding="14,6" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconCall}"
                                                 Width="14" Height="14" Foreground="{StaticResource TextSecondary}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Message Normal (Texte / Image / Voice / ViewOnce) -->
                                <Border Visibility="{Binding IsCall, Converter={StaticResource InvBoolToVis}}"
                                        Margin="0,2" Padding="10,6,8,4" CornerRadius="8" MaxWidth="520">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BubbleIn}"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BubbleOut}"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Border Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}" Background="#18262D" CornerRadius="8" Padding="10" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#53BDEB" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding AttachmentName}" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                                    <TextBlock Text="Fichier joint" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="Enregistrer le fichier"
                                                        Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding Text}" FontFamily="Segoe UI Emoji" FontSize="58" HorizontalAlignment="Left"
                                                   Visibility="{Binding IsSticker, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Photo standard (clic pour agrandir) -->
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                Command="{Binding DataContext.OpenPhotoPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanShowImage, Converter={StaticResource BoolToVis}}">
                                            <Border CornerRadius="6" ClipToBounds="True" Margin="0,0,0,4">
                                                <Image Source="{Binding Image}" MaxWidth="360" MaxHeight="300" Stretch="Uniform"/>
                                            </Border>
                                        </Button>

                                        <!-- Message Vocal (Voice Note) -->
                                        <Grid Visibility="{Binding IsVoice, Converter={StaticResource BoolToVis}}"
                                              Margin="0,2,0,4" MinWidth="240">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Width="36" Height="36" Style="{StaticResource RoundButton}"
                                                    Command="{Binding DataContext.TogglePlayVoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Grid>
                                                    <TextBlock Text="▶" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsPlayingVoice, Converter={StaticResource InvBoolToVis}}"/>
                                                    <TextBlock Text="❚❚" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsPlayingVoice, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Button>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding VoiceProgress}" Height="4"
                                                             Foreground="{DynamicResource Accent}" Background="#D0D7DE" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding VoiceDuration}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Message Vue Unique (View Once) -->
                                        <Border Visibility="{Binding ViewOnce, Converter={StaticResource BoolToVis}}"
                                                Background="{StaticResource SurfaceBg}" CornerRadius="12" Padding="10,6" Margin="0,2">
                                            <Grid>
                                                <!-- Cliquable si destinataire et pas encore ouvert -->
                                                <Button Style="{StaticResource RowButton}"
                                                        Command="{Binding DataContext.OpenViewOnceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsOpenable, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="26" Height="26" CornerRadius="13" Background="#0B3D2E" Margin="0,0,8,0">
                                                            <TextBlock Text="1" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Accent}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ViewOnceStatusText}" FontWeight="SemiBold" FontSize="13"
                                                                       Foreground="{StaticResource TextPrimary}"/>
                                                            <TextBlock Text="{DynamicResource UI.TapToView}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Statut si ouvert ou si c'est mon propre message envoyé -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsOpenable, Converter={StaticResource InvBoolToVis}}">
                                                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource SurfaceBg}" Margin="0,0,8,0">
                                                        <TextBlock Text="1" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding ViewOnceStatusText}" FontStyle="Italic" FontSize="13"
                                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Texte standard -->
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14.5"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   Visibility="{Binding CanShowText, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Heure et accusés de réception -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0"
                                                        Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                           Foreground="#8696A0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="&#x2713;&#x2713;" FontSize="11" Foreground="#8696A0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsDelivered, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="!" FontSize="12" FontWeight="Bold" Foreground="#D04A3C"
                                                           VerticalAlignment="Center" ToolTip="{DynamicResource UI.NotDelivered}"
                                                           Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Barre de saisie (Normal ou Enregistrement Vocal) -->
            <Grid Grid.Row="2" Margin="16,8,16,14">
                <!-- Mode Normal -->
                <Border Background="{StaticResource SurfaceBg}" CornerRadius="24"
                        Visibility="{Binding IsRecordingVoice, Converter={StaticResource InvBoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="+" FontFamily="Segoe UI Symbol"
                                FontSize="29" Width="42" Margin="8,0,0,0" Command="{Binding PickChatFileCommand}"
                                ToolTip="Ajouter une photo ou un fichier"/>

                        <Button x:Name="EmojiButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="40"
                                Margin="0,0,2,0" Command="{Binding ToggleEmojiPickerCommand}" ToolTip="Émojis et autocollants">
                            <TextBlock Text="😊" FontFamily="Segoe UI Emoji" FontSize="22"/>
                        </Button>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                            <Button x:Name="EphemeralButton" Style="{StaticResource IconButton}" Width="30" Margin="0"
                                    Command="{Binding ToggleEphemeralPickerCommand}" ToolTip="Durée des messages éphémères">
                                <TextBlock Text="⏳" FontFamily="Segoe UI Emoji" FontSize="17"/>
                            </Button>
                            <TextBlock Text="{Binding EphemeralDurationLabel}" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                       VerticalAlignment="Center" Margin="-2,0,3,0" IsHitTestVisible="False"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="3" Content="1×" Width="36" Height="36" Margin="2"
                                      IsChecked="{Binding SendViewOnce}" ToolTip="{DynamicResource UI.SendViewOnce}"/>

                        <!-- Champ de texte -->
                        <Grid Grid.Column="4" Margin="8,0">
                            <TextBox x:Name="InputBox" Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="48" FontSize="15" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" MaxLength="2000">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="{DynamicResource UI.MessagePlaceholder}" FontSize="15" Tag="{Binding MessageText}"
                                       Style="{StaticResource PlaceholderText}"/>
                        </Grid>

                        <!-- Micro (Enregistrer une note vocale) -->
                        <Button Grid.Column="5" Style="{StaticResource IconButton}" Width="38"
                                Command="{Binding StartVoiceRecordCommand}" ToolTip="{DynamicResource UI.RecordVoice}">
                            <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconMic}" Foreground="#AEBAC1"/>
                        </Button>

                        <!-- Envoyer -->
                        <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#xE724;"
                                Foreground="{DynamicResource Accent}" Margin="2,0,8,0"
                                Command="{Binding SendCommand}" ToolTip="{DynamicResource UI.Send}"/>
                    </Grid>
                </Border>

                <!-- Mode Enregistrement Vocal -->
                <Border Background="{StaticResource SurfaceBg}" CornerRadius="24" Height="48"
                        Visibility="{Binding IsRecordingVoice, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Indicateur rouge clignotant -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Fill="#E53935" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding RecordingTimeText}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#E53935" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{DynamicResource UI.Recording}" FontSize="14"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="20,0"/>

                        <!-- Bouton Annuler (Poubelle) -->
                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                Command="{Binding CancelVoiceRecordCommand}" ToolTip="{DynamicResource UI.CancelRecording}" Margin="0,0,8,0">
                            <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconDelete}" Foreground="#E53935"/>
                        </Button>

                        <!-- Bouton Envoyer Note Vocale -->
                        <Button Grid.Column="3" Style="{StaticResource RoundButton}" Width="36" Height="36"
                                Command="{Binding SendVoiceRecordCommand}" ToolTip="{DynamicResource UI.VoiceNote}">
                            <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconSend}" Foreground="White" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Popup Sélecteur d'Emojis -->
                <Popup IsOpen="{Binding IsEmojiPickerOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                       Placement="Top" PlacementTarget="{Binding ElementName=EmojiButton}" VerticalOffset="-10">
                    <Border Background="{StaticResource SurfaceBg}" CornerRadius="16" Width="360" Height="280" Padding="12"
                            BorderBrush="#222D34" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="4,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Autocollants" Command="{Binding ToggleStickerModeCommand}"
                                        Style="{StaticResource PillButton}" Padding="10,4" FontSize="11"/>
                                <TextBlock Text="{DynamicResource UI.Emojis}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Grille scrollable d'emojis par catégories -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsStickerMode, Converter={StaticResource InvBoolToVis}}">
                                <ItemsControl ItemsSource="{Binding EmojiCategories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}" Margin="4,2,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Emojis}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding}" Style="{StaticResource EmojiGridButton}"
                                                                    Command="{Binding DataContext.SelectEmojiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding StickerChoices}"
                                          Visibility="{Binding IsStickerMode, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Width="64" Height="64" Margin="3" Background="Transparent" BorderThickness="0"
                                            Command="{Binding DataContext.SelectStickerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding}" FontFamily="Segoe UI Emoji" FontSize="34"/>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Popup>
                <Popup IsOpen="{Binding IsEphemeralPickerOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                       Placement="Top" PlacementTarget="{Binding ElementName=EphemeralButton}" VerticalOffset="-8">
                    <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="12" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Messages éphémères" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="8,4,8,8"/>
                            <ItemsControl ItemsSource="{Binding EphemeralOptions}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Content="{Binding Label}" Command="{Binding DataContext.SetEphemeralDurationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Seconds}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                            HorizontalContentAlignment="Left" Padding="10,7" MinWidth="150"/>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- ================= CONVERSATION DE COMMUNAUTÉ ================= -->
        <Grid Grid.Column="2" Background="{StaticResource ChatPattern}" Visibility="{Binding ShowCommunityChat, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                <DockPanel Margin="18,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE902;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SelectedCommunity.MemberCountText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCommunity.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="{DynamicResource UI.Group}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CurrentCommunityMessages}" Margin="28,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBg}" CornerRadius="12" Padding="12,8" Margin="0,4" MaxWidth="520" HorizontalAlignment="Left">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource BubbleIn}"/><Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsMine}" Value="True"><Setter Property="Background" Value="{DynamicResource BubbleOut}"/><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding SenderName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                               Visibility="{Binding IsMine, Converter={StaticResource InvBoolToVis}}"/>
                                    <TextBlock Text="{Binding Text}" FontSize="14.5" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{StaticResource ChatBg}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceBg}" CornerRadius="22" Padding="14,0" Margin="0,0,8,0">
                        <TextBox Text="{Binding CommunityMessageText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                                 FontSize="14" VerticalContentAlignment="Center" MaxLength="2000">
                            <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SendCommunityMessageCommand}"/></TextBox.InputBindings>
                        </TextBox>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource RoundButton}" Command="{Binding SendCommunityMessageCommand}" ToolTip="{DynamicResource UI.Send}">
                        <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconSend}" Foreground="White" Width="17" Height="17"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="2" Background="{StaticResource ChatBg}" Visibility="{Binding ShowCommunityHome, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <Border Width="84" Height="84" CornerRadius="28" Background="#0B3D2E" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE902;" FontFamily="{StaticResource IconFont}" FontSize="38" Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource UI.CommunityHome}" FontSize="22" FontWeight="Bold" TextAlignment="Center"
                           Foreground="{StaticResource TextPrimary}" Margin="0,20,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource UI.CommunityHomeHelp}"
                           FontSize="14" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ================= CRÉATION DE COMMUNAUTÉ ================= -->
        <Grid Grid.Column="1" Grid.ColumnSpan="2" Panel.ZIndex="20" Background="#990B141A"
              Visibility="{Binding IsCommunityComposerOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="440" MaxHeight="560" Background="{StaticResource SurfaceBg}" CornerRadius="18" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource UI.NewCommunity}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <StackPanel Grid.Row="1" Margin="0,18,0,12">
                    <TextBlock Text="{DynamicResource UI.CommunityName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding CommunityNameDraft, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,6" MaxLength="50"/>
                        <TextBlock Text="{DynamicResource UI.ChooseMembers}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,4"/>
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding CommunityMemberOptions}" BorderThickness="0" MinHeight="100" MaxHeight="260">
                        <ListBox.ItemTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}" Padding="8,7" Foreground="{StaticResource TextPrimary}"/>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="{DynamicResource UI.Cancel}" Command="{Binding CancelCommunityComposerCommand}" Margin="0,0,10,0" Padding="16,8"/>
                        <Button Content="{DynamicResource UI.CreateAndInvite}" Command="{Binding CreateCommunityCommand}" Style="{StaticResource PillButton}" Padding="16,0" Height="40"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= DROITE : STATUT (ACCUEIL) ================= -->
        <Grid Grid.Column="2" Background="{StaticResource ChatBg}"
              Visibility="{Binding ShowStatusHome, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <Grid Width="56" Height="56" HorizontalAlignment="Center">
                    <local:StatusRing Total="3" Seen="3" RingThickness="5" SeenBrush="#C5C9CC"/>
                    <Ellipse Width="30" Height="30" Fill="#C5C9CC"/>
                </Grid>
                <TextBlock Text="{DynamicResource UI.StatusWelcome}" FontSize="30" HorizontalAlignment="Center" Margin="0,22,0,0"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,12,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           Text="{DynamicResource UI.StatusDescription}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <StackPanel Margin="0,0,14,0">
                        <Button Style="{StaticResource RoundGrey}" HorizontalAlignment="Center"
                                Command="{Binding StartComposeCommand}">
                            <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconEdit}"
                                     Width="20" Height="20" Foreground="#111B21"/>
                        </Button>
                        <TextBlock Text="{DynamicResource UI.WrittenStatus}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Style="{StaticResource RoundGrey}" HorizontalAlignment="Center"
                                Command="{Binding PickPhotoCommand}">
                            <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconPhotoCamera}"
                                     Width="20" Height="20" Foreground="#111B21"/>
                        </Button>
                        <TextBlock Text="{DynamicResource UI.Photo}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= DROITE : STATUT (ÉCRIRE) ================= -->
        <Grid Grid.Column="2" Background="{Binding StatusColor}"
              Visibility="{Binding ShowStatusCompose, Converter={StaticResource BoolToVis}}">
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Foreground="White"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                    Command="{Binding CancelComposeCommand}" ToolTip="{DynamicResource UI.CancelAction}"/>

            <Grid VerticalAlignment="Center" Margin="90,0">
                <TextBox Text="{Binding StatusText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                         FontSize="32" TextAlignment="Center" TextWrapping="Wrap" AcceptsReturn="True"
                         MaxLength="700" MaxHeight="420" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="{DynamicResource UI.EnterStatus}" FontSize="32" Foreground="#AAFFFFFF"
                           HorizontalAlignment="Center" Tag="{Binding StatusText}"
                           Style="{StaticResource PlaceholderText}"/>
            </Grid>

            <Grid VerticalAlignment="Bottom" Margin="28">
                <ItemsControl ItemsSource="{Binding StatusColors}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="30" Height="30" Margin="0,0,10,0" Background="{Binding}" Cursor="Hand"
                                    CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SetStatusColorCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Ellipse Fill="{TemplateBinding Background}" Stroke="White" StrokeThickness="2"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource RoundButton}" Content="&#xE724;" Width="56" Height="56"
                        HorizontalAlignment="Right" Background="{DynamicResource Accent}"
                        Command="{Binding PublishStatusCommand}" ToolTip="{DynamicResource UI.Publish}"/>
            </Grid>
        </Grid>

        <!-- ================= VISIONNEUR DE STATUT (PLEIN ÉCRAN) ================= -->
        <Grid Grid.ColumnSpan="3" Background="#111B21"
              Visibility="{Binding IsViewerOpen, Converter={StaticResource BoolToVis}}">
            <!-- Fond : couleur du statut texte -->
            <Grid Background="{Binding CurrentPost.Color}"
                  Visibility="{Binding CurrentPost.IsText, Converter={StaticResource BoolToVis}}"/>

            <!-- Fond : photo floutée -->
            <Grid ClipToBounds="True"
                  Visibility="{Binding CurrentPost.IsImage, Converter={StaticResource BoolToVis}}">
                <Image Source="{Binding CurrentPost.Image}" Stretch="UniformToFill" Margin="-80">
                    <Image.Effect>
                        <BlurEffect Radius="60" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
                <Rectangle Fill="#33000000"/>
            </Grid>

            <!-- Colonne centrale : la photo (ou le texte) -->
            <Grid Width="420" HorizontalAlignment="Center">
                <Border Background="Black" Visibility="{Binding CurrentPost.IsImage, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding CurrentPost.Image}" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{Binding CurrentPost.Text}" Foreground="White" FontSize="32" TextWrapping="Wrap"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="28,0"
                           Visibility="{Binding CurrentPost.IsText, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Barre de progression + en-tête -->
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="500" Margin="0,18,0,0">
                <ItemsControl ItemsSource="{Binding Segments}" Height="3">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ProgressBar Style="{StaticResource StorySegment}" Value="{Binding Value}" Margin="1.5,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="38" Height="38" VerticalAlignment="Center">
                        <Ellipse Fill="{Binding ViewerGroup.AvatarBg}"/>
                        <TextBlock Text="{Binding ViewerGroup.Initial}" Foreground="{Binding ViewerGroup.AvatarFg}"
                                   FontWeight="SemiBold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding ViewerName}" Foreground="White" FontSize="14.5"/>
                        <TextBlock Text="{Binding CurrentPost.TimeText}" Foreground="#E6FFFFFF" FontSize="12.5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ViewerButton}" Command="{Binding TogglePauseCommand}">
                            <Grid>
                                <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconPause}" Foreground="White"
                                         Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconPlay}" Foreground="White"
                                         Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                        <Button x:Name="MoreBtn" Style="{StaticResource ViewerButton}"
                                Command="{Binding OpenMoreMenuCommand}">
                            <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconMoreVert}" Foreground="White"/>
                        </Button>

                        <Popup IsOpen="{Binding IsMoreMenuOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                               Placement="Bottom" PlacementTarget="{Binding ElementName=MoreBtn}" HorizontalOffset="-110">
                            <Border Margin="10" Background="{StaticResource SurfaceBg}" CornerRadius="12" Padding="0,6" MinWidth="170"
                                    BorderBrush="#12000000" BorderThickness="1">
                                <StackPanel>
                                    <Button Style="{StaticResource MenuRow}" Command="{Binding DeleteStatusCommand}"
                                            Visibility="{Binding ViewerIsMine, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource UI.DeleteStatus}" FontSize="13.5" Margin="12,0,0,0"
                                                   Foreground="#C0392B" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource MenuRow}" Command="{Binding ReplyPrivateCommand}"
                                            Visibility="{Binding ViewerIsOther, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource UI.ReplyPrivate}" FontSize="13.5" Margin="12,0,0,0"
                                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Flèche retour et croix -->
            <Button Style="{StaticResource ViewerButton}" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="20,16,0,0" Command="{Binding CloseViewerCommand}" ToolTip="{DynamicResource UI.Back}">
                <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconArrowBack}" Foreground="White"/>
            </Button>
            <Button Style="{StaticResource ViewerButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,20,0" Command="{Binding CloseViewerCommand}" ToolTip="{DynamicResource UI.Close}">
                <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconClose}" Foreground="White"/>
            </Button>

            <!-- Flèches précédent / suivant -->
            <Button Style="{StaticResource NavButton}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="28,0,0,0" Command="{Binding PrevCommand}"
                    Visibility="{Binding HasPrev, Converter={StaticResource BoolToVis}}">
                <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconChevronLeft}"
                         Foreground="White" Width="22" Height="22"/>
            </Button>
            <Button Style="{StaticResource NavButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,28,0" Command="{Binding NextCommand}"
                    Visibility="{Binding HasNext, Converter={StaticResource BoolToVis}}">
                <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconChevronRight}"
                         Foreground="White" Width="22" Height="22"/>
            </Button>

            <!-- Bas : statut d'un contact = barre de réponse -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Width="660" Height="44"
                  Visibility="{Binding ViewerIsOther, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="22" Background="#8C2B3136" Height="42">
                    <Grid>
                        <TextBox Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}" Margin="16,0,120,0"
                                 BorderThickness="0" Background="Transparent" Foreground="White" CaretBrush="White"
                                 FontSize="14" VerticalContentAlignment="Center" MaxLength="500">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendReplyCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{DynamicResource UI.TypeReply}" FontSize="14" Margin="16,0,0,0" Foreground="#E6FFFFFF"
                                   Tag="{Binding ReplyText}" Style="{StaticResource PlaceholderText}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                            <Button Style="{StaticResource ViewerButton}" Width="32" Height="32"
                                    Command="{Binding ReactCommand}" CommandParameter="😍">
                                <TextBlock Text="😍" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource ViewerButton}" Width="32" Height="32"
                                    Command="{Binding ReactCommand}" CommandParameter="😂">
                                <TextBlock Text="😂" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource ViewerButton}" Width="32" Height="32"
                                    Command="{Binding ReactCommand}" CommandParameter="❤️">
                                <TextBlock Text="❤️" FontSize="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= OVERLAY APPEL AUDIO & VIDÉO ================= -->
        <Grid Grid.ColumnSpan="3" Background="#111B21"
              Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête de l'appel -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,40,0,0">
                <TextBlock Text="{Binding CallStatusText}" FontSize="15" Foreground="#AAFFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CallContactName}" FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Centre : Avatar / Waveform ou Vidéo -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Mode Appel Audio : Grand Avatar avec ondes vocales réactives -->
                <StackPanel Visibility="{Binding IsAudioCall, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                    <Grid Width="170" Height="170" HorizontalAlignment="Center">
                        <!-- Anneau d'onde sonore pulsante -->
                        <Ellipse Width="160" Height="160" Stroke="{DynamicResource Accent}" StrokeThickness="3" Opacity="0.45"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="{Binding AudioWaveScale}" ScaleY="{Binding AudioWaveScale}"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <!-- Avatar -->
                        <Ellipse Width="120" Height="120" Fill="{Binding CallContactAvatarBg}"/>
                        <TextBlock Text="{Binding CallContactInitial}" Foreground="{Binding CallContactAvatarFg}"
                                   FontWeight="Bold" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- Indicateur d'activité vocale (Waveform) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Border Width="6" Height="16" Background="{DynamicResource Accent}" CornerRadius="3" Margin="3,0"/>
                        <Border Width="6" Height="26" Background="{DynamicResource Accent}" CornerRadius="3" Margin="3,0"/>
                        <Border Width="6" Height="38" Background="{DynamicResource Accent}" CornerRadius="3" Margin="3,0"/>
                        <Border Width="6" Height="26" Background="{DynamicResource Accent}" CornerRadius="3" Margin="3,0"/>
                        <Border Width="6" Height="16" Background="{DynamicResource Accent}" CornerRadius="3" Margin="3,0"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding CallDurationText}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Mode Appel Vidéo : Vrai flux vidéo distant et miniature locale -->
                <Border Visibility="{Binding IsVideoCall, Converter={StaticResource BoolToVis}}"
                        Width="640" Height="420" Background="#20243A" CornerRadius="18" BorderBrush="#444962" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <!-- Flux vidéo distant (caméra du contact) -->
                        <Image Source="{Binding RemoteVideoImage}" Stretch="UniformToFill"/>

                        <!-- Si pas encore de flux vidéo reçu, avatar d'attente -->
                        <Grid Visibility="{Binding HasRemoteVideo, Converter={StaticResource InvBoolToVis}}" Background="#182229">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Ellipse Fill="{Binding CallContactAvatarBg}"/>
                                    <TextBlock Text="{Binding CallContactInitial}" Foreground="{Binding CallContactAvatarFg}"
                                               FontWeight="Bold" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding CallStatusText}" Foreground="#8696A0" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bandeau d'information distant (Haut) -->
                        <Border VerticalAlignment="Top" Background="#80000000" Padding="14,8">
                            <DockPanel>
                                <TextBlock Text="{Binding CallDurationText}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="13" DockPanel.Dock="Right"/>
                                <TextBlock Text="{Binding CallContactName}" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                            </DockPanel>
                        </Border>

                        <!-- Flux vidéo local (Vous - Picture in Picture) -->
                        <Border Width="160" Height="120" Background="#1E2A30" CornerRadius="12"
                                BorderBrush="White" BorderThickness="2"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding LocalVideoImage}" Stretch="UniformToFill"/>
                                <Border VerticalAlignment="Bottom" Background="#80000000" Padding="6,2">
                                    <TextBlock Text="{DynamicResource UI.You}" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Commandes en bas de l'appel -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,50">
                <!-- Si appel entrant : Décrocher (Vert) ou Refuser (Rouge) -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsIncomingCall, Converter={StaticResource BoolToVis}}">
                    <Button Width="64" Height="64" Background="#E53935" Margin="0,0,40,0" Style="{StaticResource RoundButton}"
                            Command="{Binding RejectCallCommand}" ToolTip="{DynamicResource UI.RejectCall}">
                        <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconCallEnd}" Foreground="White" Width="28" Height="28"/>
                    </Button>
                    <Button Width="64" Height="64" Background="{DynamicResource Accent}" Style="{StaticResource RoundButton}"
                            Command="{Binding AcceptCallCommand}" ToolTip="{DynamicResource UI.AnswerCall}">
                        <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconCall}" Foreground="White" Width="28" Height="28"/>
                    </Button>
                </StackPanel>

                <!-- Si appel actif ou sortant : Mute, Camera, Raccrocher -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsIncomingCall, Converter={StaticResource InvBoolToVis}}">
                    <!-- Mute Micro -->
                    <Button Width="52" Height="52" Background="#2A3942" Margin="0,0,20,0" Style="{StaticResource RoundButton}"
                            Command="{Binding ToggleMicMuteCommand}" ToolTip="{DynamicResource UI.Microphone}">
                        <Grid>
                            <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconMic}" Foreground="White" Width="22" Height="22"
                                     Visibility="{Binding IsMicMuted, Converter={StaticResource InvBoolToVis}}"/>
                            <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconMicOff}" Foreground="#E53935" Width="22" Height="22"
                                     Visibility="{Binding IsMicMuted, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>

                    <!-- Toggle Caméra (si vidéo) -->
                    <Button Width="52" Height="52" Background="#2A3942" Margin="0,0,20,0" Style="{StaticResource RoundButton}"
                            Command="{Binding ToggleCameraCommand}" ToolTip="{DynamicResource UI.Camera}"
                            Visibility="{Binding IsVideoCall, Converter={StaticResource BoolToVis}}">
                        <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconVideo}" Foreground="White" Width="22" Height="22"/>
                    </Button>

                    <!-- Raccrocher -->
                    <Button Width="60" Height="60" Background="#E53935" Style="{StaticResource RoundButton}"
                            Command="{Binding EndCallCommand}" ToolTip="{DynamicResource UI.HangUp}">
                        <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconCallEnd}" Foreground="White" Width="26" Height="26"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= MODAL VUE UNIQUE (VIEW ONCE) ================= -->
        <Grid Grid.ColumnSpan="3" Background="#EE0B141A"
              Visibility="{Binding IsViewOnceModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="480" MaxHeight="600" Background="#111B21" CornerRadius="18" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête : badge et compte à rebours -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ViewerButton}"
                                Command="{Binding CloseViewOnceModalCommand}">
                            <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconClose}" Foreground="White"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#0B3D2E" Margin="0,0,10,0">
                                <TextBlock Text="1" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource UI.ViewOnceTitle}" FontSize="16" FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Border Background="#E53935" CornerRadius="10" Padding="8,2" Margin="12,0,0,0">
                                <TextBlock Text="{Binding ViewOnceCountdownText}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Contenu du message secret -->
                    <Grid Grid.Row="1" MinHeight="180">
                        <!-- Si photo -->
                        <Image Source="{Binding ViewOnceImage}" Stretch="Uniform" MaxHeight="400"
                               Visibility="{Binding HasViewOnceImage, Converter={StaticResource BoolToVis}}"/>

                        <!-- Si texte -->
                        <Border Background="#1F2C34" CornerRadius="12" Padding="20"
                                Visibility="{Binding HasViewOnceText, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ViewOnceText}" FontSize="18" TextWrapping="Wrap"
                                       Foreground="White" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Bas : note de confidentialité et bouton Fermer -->
                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock Text="{DynamicResource UI.ViewOnceDescription}"
                                   FontSize="12" Foreground="#8696A0" TextAlignment="Center" Margin="0,0,0,12"/>
                        <Button Content="{DynamicResource UI.Close}" Style="{StaticResource PillButton}" Height="38"
                                Command="{Binding CloseViewOnceModalCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL APERÇU PHOTO PLEIN ÉCRAN (LIGHTBOX) ================= -->
        <Grid Grid.ColumnSpan="3" Background="#DD0B141A"
              Visibility="{Binding IsPhotoViewerOpen, Converter={StaticResource BoolToVis}}">
            <Button Style="{StaticResource ViewerButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,20,24,0" Command="{Binding ClosePhotoPreviewCommand}" ToolTip="{DynamicResource UI.Close}">
                <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconClose}" Foreground="White" Width="24" Height="24"/>
            </Button>
            <Border Margin="40,60" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxWidth="900" MaxHeight="650"/>
            </Border>
        </Grid>

        <!-- ================= MESSAGE TEMPORAIRE (TOAST) ================= -->
        <Border Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,24"
                MaxWidth="330" Padding="22,16" CornerRadius="16" Background="#FF2B2F33"
                Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
