<Window x:Class="ChatLocal.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhatsApp — Accès sécurisé" Icon="/Assets/WhatsApp.ico" Width="440" Height="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#0B141A" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#25D366"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E9EDEF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AEBAC1"/>
        <SolidColorBrush x:Key="Divider" Color="#2A3942"/>
        <SolidColorBrush x:Key="Selected" Color="#202C33"/>

        <Style x:Key="NumpadButton" TargetType="Button">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#202C33"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderBrush="#2A3942" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3942"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#35434A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabToggle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="Transparent" Padding="16,8" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#202C33"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#111B21" Margin="16" CornerRadius="20" Padding="24,20"
            BorderBrush="#26343B" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.08" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo & En-tête -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                    <Image Source="/Assets/WhatsApp.png" Width="62" Height="62" Stretch="Uniform"/>
                    <Border Width="22" Height="22" Background="#25D366" CornerRadius="11"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                        <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconLock}"
                                 Foreground="#0B141A" Width="12" Height="12"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <TextBlock Text="WhatsApp" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center" Margin="0,10,0,2"/>
                <TextBlock x:Name="HeaderSubtitle" Text="Accès sécurisé" FontSize="13" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Nom de l'utilisateur -->
            <StackPanel Grid.Row="1" Margin="0,12,0,2">
                <TextBlock Text="Identifiant utilisateur :" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" Margin="2,0,0,4"/>
                <Border CornerRadius="10" Background="#202C33" BorderBrush="#2A3942" BorderThickness="1" Height="38">
                    <TextBox x:Name="NameBox" BorderThickness="0" Background="Transparent" FontSize="14"
                             VerticalContentAlignment="Center" Padding="10,0" MaxLength="30"
                             Foreground="{StaticResource TextPrimary}"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <RadioButton x:Name="LoginModeRadio" GroupName="accountMode" Content="Se connecter" Style="{StaticResource TabToggle}"
                                 IsChecked="True" Checked="Mode_Changed" Margin="0,0,4,0"/>
                    <RadioButton x:Name="CreateModeRadio" GroupName="accountMode" Content="Créer un compte" Style="{StaticResource TabToggle}"
                                 Checked="Mode_Changed"/>
                </StackPanel>
            </StackPanel>

            <!-- Saisie du code PIN -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <StackPanel x:Name="PinPanel" VerticalAlignment="Center">
                    <TextBlock x:Name="PinPromptText" Text="Entrez votre code PIN (4 chiffres)"
                               FontSize="13.5" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>

                    <!-- Visualisation des 4 points du code PIN -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,12">
                        <Border x:Name="Dot1" Width="14" Height="14" CornerRadius="7" Background="#2A3942" Margin="6,0"/>
                        <Border x:Name="Dot2" Width="14" Height="14" CornerRadius="7" Background="#2A3942" Margin="6,0"/>
                        <Border x:Name="Dot3" Width="14" Height="14" CornerRadius="7" Background="#2A3942" Margin="6,0"/>
                        <Border x:Name="Dot4" Width="14" Height="14" CornerRadius="7" Background="#2A3942" Margin="6,0"/>
                    </StackPanel>

                    <PasswordBox x:Name="PinBox" Height="0" Opacity="0" PasswordChanged="PinBox_PasswordChanged"/>

                    <!-- Clavier numérique virtuel -->
                    <UniformGrid Columns="3" HorizontalAlignment="Center">
                        <Button Content="1" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
                        <Button Content="2" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
                        <Button Content="3" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
                        <Button Content="4" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
                        <Button Content="5" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
                        <Button Content="6" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
                        <Button Content="7" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
                        <Button Content="8" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
                        <Button Content="9" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
                        <Button Content="⌫" Style="{StaticResource NumpadButton}" Click="Backspace_Click" FontSize="18"/>
                        <Button Content="0" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
                        <Button Content="✓" Style="{StaticResource NumpadButton}" Click="Enter_Click"
                                Foreground="{StaticResource Accent}" FontWeight="Bold"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- Message d'erreur et Bouton Continuer -->
            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <TextBlock x:Name="ErrorText" Foreground="#FF7B72" FontSize="12.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Button x:Name="SubmitButton" Content="Déverrouiller" Style="{StaticResource PillButton}"
                        Height="42" Click="Submit_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
