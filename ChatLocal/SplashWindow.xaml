<Window x:Class="ChatLocal.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Local" Width="1180" Height="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#F0F0F8" FontFamily="Segoe UI">
    <Border BorderBrush="#D1D7DB" BorderThickness="1">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,24">
                <!-- Logo -->
                <Border Width="72" Height="72" CornerRadius="24" Background="#EFEEFF" HorizontalAlignment="Center">
                    <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconChatBubble}"
                             Width="38" Height="38" Foreground="{StaticResource Accent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="WhatsApp" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"
                           Foreground="{StaticResource TextPrimary}"/>

                <!-- Barre de progression -->
                <Border Width="200" Height="4" CornerRadius="2" Background="#DCDFE1" Margin="0,22,0,0">
                    <Border x:Name="Fill" Width="0" HorizontalAlignment="Left" CornerRadius="2"
                            Background="{StaticResource Accent}"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Control Style="{StaticResource SvgIcon}" Tag="{StaticResource IconLock}"
                             Width="14" Height="14" Foreground="{StaticResource TextSecondary}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="Chiffré de bout en bout" FontSize="13" Margin="5,0,0,0"
                             Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
